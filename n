[global]
    width = 320
    height = 150
    origin = top-right
    offset = 12x40
    frame_width = 1
    frame_color = "#89b4fa"
    font = Noto Sans 10
    format = "<b>%s</b>\n%b"
    corner_radius = 8
 
[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5
 
[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8
 
[urgency_critical]
    background = "#f38ba8"
    foreground = "#1e1e2e"
    timeout = 0
